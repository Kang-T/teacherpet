{
  "name": "teacherpet",
  "productName": "티처펫",
  "version": "0.1.0",
  "description": "병아리를 부탁해 — 초등학생이 닭의 한살이를 배우는 웹 게임 (개인정보 0 수집)",
  "main": "src/main.js",
  "author": "Kang-T",
  "license": "MIT",
  "homepage": "https://github.com/Kang-T/teacherpet",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kang-T/teacherpet.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --publish always",
    "web": "node scripts/build-web.js",
    "web:serve": "node scripts/build-web.js && cd web && python3 -m http.server 8777",
    "check": "node scripts/check.js",
    "shot": "node scripts/check.js",
    "quiz-doc": "node scripts/quiz-doc.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.teacherpet.app",
    "productName": "티처펫",
    "artifactName": "TeacherPet-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "티처펫",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "publish": {
      "provider": "github",
      "owner": "Kang-T",
      "repo": "teacherpet",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
